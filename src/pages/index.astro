---
// The homepage. Each <section> below is one band of the page — ask the AI to
// add, remove, or reorder them. Every `km` field / class="km" line is the Khmer
// caption shown under the English.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

const stats = [
  { value: '900 km/h', label: 'how fast a passenger jet flies', labelKm: 'ល្បឿនយន្តហោះដឹកអ្នកដំណើរ' },
  { value: '11 km', label: 'how high it usually flies', labelKm: 'កម្ពស់ដែលវាហោះជាធម្មតា' },
  { value: '1903', label: 'the first airplane flight', labelKm: 'ការហោះហើរលើកដំបូងរបស់យន្តហោះ' },
];

const forces = [
  {
    icon: '⬆️',
    title: 'Lift',
    titleKm: 'កម្លាំងលើក',
    text: 'The wings push air down, so the air pushes the plane up.',
    textKm: 'ស្លាបរុញខ្យល់ចុះក្រោម ដូច្នេះខ្យល់រុញយន្តហោះឡើងលើ។',
  },
  {
    icon: '⬇️',
    title: 'Weight',
    titleKm: 'ទម្ងន់',
    text: 'Gravity pulls the plane down to the ground.',
    textKm: 'ទំនាញផែនដីទាញយន្តហោះចុះមកដី។',
  },
  {
    icon: '➡️',
    title: 'Thrust',
    titleKm: 'កម្លាំងរុញ',
    text: 'The engines push the plane forward.',
    textKm: 'ម៉ាស៊ីនរុញយន្តហោះទៅមុខ។',
  },
  {
    icon: '⬅️',
    title: 'Drag',
    titleKm: 'កម្លាំងទប់',
    text: 'The air pushes back against the plane and slows it down.',
    textKm: 'ខ្យល់រុញទប់យន្តហោះ ហើយធ្វើឱ្យវាយឺត។',
  },
];

const planes = [
  {
    icon: '✈️',
    title: 'Passenger jet',
    titleKm: 'យន្តហោះដឹកអ្នកដំណើរ',
    text: 'Carries 100 to 500 people between cities and countries.',
    textKm: 'ដឹកមនុស្សពី ១០០ ទៅ ៥០០ នាក់ រវាងទីក្រុង និងប្រទេស។',
  },
  {
    icon: '📦',
    title: 'Cargo plane',
    titleKm: 'យន្តហោះដឹកទំនិញ',
    text: 'Carries boxes, mail, and goods around the world.',
    textKm: 'ដឹកប្រអប់ សំបុត្រ និងទំនិញជុំវិញពិភពលោក។',
  },
  {
    icon: '🛩️',
    title: 'Small propeller plane',
    titleKm: 'យន្តហោះតូចមានស្លាបចក្រ',
    text: 'Has a propeller at the front. Many pilots learn to fly in one.',
    textKm: 'មានស្លាបចក្រនៅខាងមុខ។ អ្នកបើកយន្តហោះជាច្រើនរៀនហោះជាមួយយន្តហោះប្រភេទនេះ។',
  },
  {
    icon: '🌊',
    title: 'Seaplane',
    titleKm: 'យន្តហោះចុះលើទឹក',
    text: 'Can take off and land on water.',
    textKm: 'អាចហោះឡើង និងចុះចតលើទឹកបាន។',
  },
  {
    icon: '⚡',
    title: 'Fighter jet',
    titleKm: 'យន្តហោះចម្បាំង',
    text: 'Very fast. Some fly faster than the speed of sound.',
    textKm: 'លឿនណាស់។ ខ្លះហោះលឿនជាងល្បឿនសំឡេង។',
  },
  {
    icon: '🕊️',
    title: 'Glider',
    titleKm: 'យន្តហោះគ្មានម៉ាស៊ីន',
    text: 'Has no engine. It rides the wind, like a bird.',
    textKm: 'គ្មានម៉ាស៊ីនទេ។ វាហោះតាមខ្យល់ ដូចសត្វស្លាប។',
  },
];

const airports = [
  {
    title: 'Techo International Airport',
    titleKm: 'អាកាសយានដ្ឋានអន្តរជាតិតេជោ',
    place: 'Phnom Penh',
    placeKm: 'ភ្នំពេញ',
    text: 'Cambodia’s newest and biggest airport. It opened in 2025.',
    textKm: 'អាកាសយានដ្ឋានថ្មីបំផុត និងធំបំផុតរបស់កម្ពុជា។ វាបានបើកនៅឆ្នាំ ២០២៥។',
  },
  {
    title: 'Siem Reap–Angkor International Airport',
    titleKm: 'អាកាសយានដ្ឋានអន្តរជាតិសៀមរាប-អង្គរ',
    place: 'Siem Reap',
    placeKm: 'សៀមរាប',
    text: 'The airport for visiting Angkor Wat. It opened in 2023.',
    textKm: 'អាកាសយានដ្ឋានសម្រាប់ទស្សនាអង្គរវត្ត។ វាបានបើកនៅឆ្នាំ ២០២៣។',
  },
  {
    title: 'Sihanouk International Airport',
    titleKm: 'អាកាសយានដ្ឋានអន្តរជាតិព្រះសីហនុ',
    place: 'Preah Sihanouk',
    placeKm: 'ព្រះសីហនុ',
    text: 'Near the beaches by the sea.',
    textKm: 'នៅជិតឆ្នេរសមុទ្រ។',
  },
];

const faqs = [
  {
    q: 'Who flew the first airplane?',
    qKm: 'តើនរណាជាអ្នកបើកយន្តហោះដំបូងគេ?',
    a: 'The Wright brothers, in the USA, in 1903. Their first flight lasted only 12 seconds!',
    aKm: 'បងប្អូន Wright នៅសហរដ្ឋអាមេរិក ក្នុងឆ្នាំ ១៩០៣។ ការហោះហើរលើកដំបូងរបស់ពួកគេមានរយៈពេលតែ ១២ វិនាទីប៉ុណ្ណោះ!',
  },
  {
    q: 'Why do my ears pop on a plane?',
    qKm: 'ហេតុអ្វីត្រចៀកខ្ញុំស្ទះពេលជិះយន្តហោះ?',
    a: 'The air pressure changes when the plane goes up and down. Swallow or yawn to help your ears.',
    aKm: 'សម្ពាធខ្យល់ប្រែប្រួល ពេលយន្តហោះឡើង និងចុះ។ លេបទឹកមាត់ ឬស្ងាប ដើម្បីជួយត្រចៀករបស់អ្នក។',
  },
  {
    q: 'Is flying safe?',
    qKm: 'តើការជិះយន្តហោះមានសុវត្ថិភាពទេ?',
    a: 'Yes. Flying is one of the safest ways to travel. Pilots train for many years, and planes are checked often.',
    aKm: 'បាទ/ចាស។ ការជិះយន្តហោះជាមធ្យោបាយធ្វើដំណើរមួយដែលមានសុវត្ថិភាពបំផុត។ អ្នកបើកយន្តហោះហ្វឹកហាត់ច្រើនឆ្នាំ ហើយយន្តហោះត្រូវបានពិនិត្យជាញឹកញាប់។',
  },
  {
    q: 'How can I become a pilot?',
    qKm: 'តើខ្ញុំអាចក្លាយជាអ្នកបើកយន្តហោះដោយរបៀបណា?',
    a: 'Study hard in math, physics, and English. Then go to a flight school. Training takes about two years.',
    aKm: 'រៀនឱ្យពូកែគណិតវិទ្យា រូបវិទ្យា និងភាសាអង់គ្លេស។ បន្ទាប់មកចូលរៀននៅសាលាបង្ហាត់បើកយន្តហោះ។ ការហ្វឹកហាត់ចំណាយពេលប្រហែលពីរឆ្នាំ។',
  },
];
---

<Base>
  <Header />

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-brand/15 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-40 size-[30rem] rounded-full bg-sun/20 blur-3xl"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-white/70 px-3 py-1 text-sm font-medium">
            <span class="size-2 rounded-full bg-leaf"></span>
            A simple guide for students in Cambodia
          </p>
          <h1 class="mt-6 font-display text-5xl leading-[1.02] font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl">
            How do <span class="text-brand">airplanes</span> fly?
          </h1>
          <p lang="km" class="mt-4 text-xl text-ink/70">តើយន្តហោះហោះហើរដោយរបៀបណា?</p>
          <p class="mt-6 max-w-xl text-lg text-muted">
            Learn the four forces of flight, the kinds of planes, and the airports in Cambodia.
            <span class="km" lang="km">រៀនពីកម្លាំងទាំងបួននៃការហោះហើរ ប្រភេទយន្តហោះ និងអាកាសយានដ្ឋាននៅកម្ពុជា។</span>
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#how" class="rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark">
              Start learning ↓ <span lang="km" class="font-khmer font-normal opacity-80">ចាប់ផ្តើមរៀន</span>
            </a>
            <a href="#planes" class="rounded-full border border-ink/15 bg-white px-6 py-3 font-semibold transition hover:border-ink/40">
              Types of planes → <span lang="km" class="font-khmer font-normal opacity-60">ប្រភេទយន្តហោះ</span>
            </a>
          </div>
        </div>

        <!-- Illustration: a plane flying through the sky, past the clouds -->
        <div class="relative h-72 overflow-hidden rounded-3xl bg-gradient-to-b from-brand to-sky-300 shadow-2xl sm:h-96" aria-hidden="true">
          <div class="absolute top-6 right-8 size-16 rounded-full bg-sun shadow-[0_0_60px] shadow-sun/70"></div>
          <div class="absolute top-16 left-6 h-10 w-32 rounded-full bg-white/90"></div>
          <div class="absolute top-12 left-14 h-12 w-16 rounded-full bg-white/90"></div>
          <div class="absolute right-10 bottom-14 h-12 w-40 rounded-full bg-white/80"></div>
          <div class="absolute right-24 bottom-20 h-14 w-20 rounded-full bg-white/80"></div>
          <div class="absolute bottom-10 left-6 h-8 w-24 rounded-full bg-white/70"></div>
          <div class="absolute top-[55%] left-[8%] w-[55%] -rotate-12 border-t-4 border-dashed border-white/70"></div>
          <span class="absolute top-[30%] left-[55%] text-7xl drop-shadow-lg sm:text-8xl">✈️</span>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="border-y border-ink/10 bg-white">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-10 sm:px-6 md:grid-cols-3">
        {
          stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd class="font-display text-4xl font-extrabold text-brand">{s.value}</dd>
              <dd class="mt-1 text-sm text-muted">
                {s.label}
                <span class="km" lang="km">{s.labelKm}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- HOW PLANES FLY -->
    <section id="how" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">How planes fly <span lang="km" class="font-khmer font-normal">· របៀបដែលយន្តហោះហោះហើរ</span></p>
      <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
        Four forces keep a plane in the sky.
      </h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">កម្លាំងបួនរក្សាយន្តហោះឱ្យនៅលើមេឃ។</p>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          forces.map((f) => (
            <li class="rounded-2xl border border-ink/10 bg-white p-6">
              <span class="text-3xl">{f.icon}</span>
              <h3 class="mt-4 font-display text-xl font-bold">
                {f.title}
                <span class="km text-base" lang="km">{f.titleKm}</span>
              </h3>
              <p class="mt-2 text-muted">
                {f.text}
                <span class="km" lang="km">{f.textKm}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- BIG STATEMENT -->
    <section class="bg-ink text-paper">
      <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-28">
        <p class="font-display text-3xl leading-tight font-bold text-balance sm:text-5xl">
          When <span class="text-sun">lift is bigger than weight</span>, the plane goes up.
        </p>
        <p lang="km" class="km mt-6 text-xl sm:text-2xl">
          ពេលកម្លាំងលើកធំជាងទម្ងន់ យន្តហោះឡើងលើ។
        </p>
      </div>
    </section>

    <!-- TYPES OF PLANES -->
    <section id="planes" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">Types of planes <span lang="km" class="font-khmer font-normal">· ប្រភេទយន្តហោះ</span></p>
      <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Many planes, many jobs.</h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">យន្តហោះច្រើនប្រភេទ ការងារច្រើនយ៉ាង។</p>
      <ul class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          planes.map((p) => (
            <li class="rounded-2xl border border-ink/10 bg-white p-6 transition hover:-translate-y-1 hover:border-brand hover:shadow-xl">
              <span class="text-4xl">{p.icon}</span>
              <h3 class="mt-4 font-display text-2xl font-bold">
                {p.title}
                <span class="km text-lg" lang="km">{p.titleKm}</span>
              </h3>
              <p class="mt-2 text-muted">
                {p.text}
                <span class="km" lang="km">{p.textKm}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- AIRPORTS IN CAMBODIA -->
    <section id="airports" class="scroll-mt-20 bg-white">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1fr_1.4fr]">
        <div>
          <p class="font-semibold text-brand">In Cambodia <span lang="km" class="font-khmer font-normal">· នៅកម្ពុជា</span></p>
          <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Airports in Cambodia</h2>
          <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">អាកាសយានដ្ឋាននៅកម្ពុជា</p>
          <p class="mt-4 text-lg text-muted">
            Planes from many countries land here every day.
            <span class="km" lang="km">យន្តហោះពីប្រទេសជាច្រើនចុះចតនៅទីនេះរៀងរាល់ថ្ងៃ។</span>
          </p>
        </div>
        <ul class="grid gap-4">
          {
            airports.map((a) => (
              <li class="rounded-2xl bg-paper p-6">
                <p class="text-sm font-semibold text-leaf">
                  📍 {a.place} <span lang="km" class="font-khmer font-normal">· {a.placeKm}</span>
                </p>
                <h3 class="mt-2 font-display text-lg font-bold">
                  {a.title}
                  <span class="km text-base" lang="km">{a.titleKm}</span>
                </h3>
                <p class="mt-1 text-muted">
                  {a.text}
                  <span class="km" lang="km">{a.textKm}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-28">
      <h2 class="text-center font-display text-4xl font-extrabold tracking-tight">Questions</h2>
      <p class="km mt-2 text-center text-xl font-semibold" lang="km">សំណួរ</p>
      <div class="mt-10 divide-y divide-ink/10 border-y border-ink/10">
        {
          faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-bold">
                <span>
                  {f.q}
                  <span class="km text-base" lang="km">{f.qKm}</span>
                </span>
                <span class="text-2xl text-brand transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-muted">
                {f.a}
                <span class="km" lang="km">{f.aKm}</span>
              </p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- CALL TO ACTION -->
    <section id="contact" class="scroll-mt-20 px-4 pb-20 sm:px-6">
      <div class="mx-auto max-w-6xl rounded-3xl bg-brand px-6 py-16 text-center text-paper sm:py-20">
        <h2 class="font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">Have a question about airplanes?</h2>
