---
// The homepage. Each <section> below is one band of the page — ask the AI to
// add, remove, or reorder them. Every `km` field / class="km" line is the Khmer
// caption shown under the English.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

const stats = [
  { value: '5 am', label: 'we start baking', labelKm: 'យើងចាប់ផ្តើមដុតនំ' },
  { value: '20+', label: 'kinds of bread and cakes', labelKm: 'ប្រភេទនំប៉័ង និងនំខេក' },
  { value: '100%', label: 'fresh every day', labelKm: 'ស្រស់រៀងរាល់ថ្ងៃ' },
];

// TODO: change these to your real menu and prices.
const menu = [
  {
    icon: '🥖',
    title: 'Baguette',
    titleKm: 'នំប៉័ងបារាំង',
    price: '$0.50',
    text: 'Crispy outside, soft inside. Great for nom pang.',
    textKm: 'ស្រួយនៅខាងក្រៅ ទន់នៅខាងក្នុង។ ល្អសម្រាប់ធ្វើនំប៉័ងសាច់។',
  },
  {
    icon: '🥐',
    title: 'Croissant',
    titleKm: 'នំក្រូសង់',
    price: '$1.50',
    text: 'Buttery and flaky. Best with coffee.',
    textKm: 'មានរសជាតិប៊ឺ និងស្រួយ។ ឆ្ងាញ់បំផុតជាមួយកាហ្វេ។',
  },
  {
    icon: '🥥',
    title: 'Coconut bun',
    titleKm: 'នំប៉័ងដូង',
    price: '$0.75',
    text: 'A soft bun with sweet coconut inside.',
    textKm: 'នំប៉័ងទន់ មានដូងផ្អែមនៅខាងក្នុង។',
  },
  {
    icon: '🍩',
    title: 'Donut',
    titleKm: 'នំដូណាត់',
    price: '$0.75',
    text: 'Fresh and sweet, with sugar or chocolate.',
    textKm: 'ស្រស់ និងផ្អែម មានស្ករ ឬសូកូឡា។',
  },
  {
    icon: '🎂',
    title: 'Birthday cake',
    titleKm: 'នំខួបកំណើត',
    price: 'from $15',
    text: 'Order 2 days before. We write your message on top.',
    textKm: 'កុម្ម៉ង់មុន ២ ថ្ងៃ។ យើងសរសេរពាក្យជូនពររបស់អ្នកនៅលើនំ។',
  },
  {
    icon: '☕',
    title: 'Iced coffee',
    titleKm: 'កាហ្វេទឹកដោះគោទឹកកក',
    price: '$1.25',
    text: 'Cambodian iced coffee with sweet milk.',
    textKm: 'កាហ្វេទឹកកកខ្មែរ ជាមួយទឹកដោះគោផ្អែម។',
  },
];

const reasons = [
  {
    icon: '🌅',
    title: 'Baked every morning',
    titleKm: 'ដុតរៀងរាល់ព្រឹក',
    text: 'We start at 5 am, so everything is fresh.',
    textKm: 'យើងចាប់ផ្តើមម៉ោង ៥ ព្រឹក ដូច្នេះអ្វីៗទាំងអស់ស្រស់។',
  },
  {
    icon: '🧈',
    title: 'Good ingredients',
    titleKm: 'គ្រឿងផ្សំល្អ',
    text: 'Real butter and fresh eggs. No shortcuts.',
    textKm: 'ប៊ឺពិត និងពងមាន់ស្រស់។ យើងធ្វើយ៉ាងយកចិត្តទុកដាក់។',
  },
  {
    icon: '💵',
    title: 'Fair prices',
    titleKm: 'តម្លៃសមរម្យ',
    text: 'Good bread for every family.',
    textKm: 'នំប៉័ងល្អសម្រាប់គ្រប់គ្រួសារ។',
  },
  {
    icon: '🛵',
    title: 'Delivery',
    titleKm: 'ដឹកជញ្ជូន',
    text: 'Order on Telegram, and we deliver in Phnom Penh.',
    textKm: 'កុម្ម៉ង់តាម Telegram ហើយយើងដឹកជូននៅភ្នំពេញ។',
  },
];

// TODO: put your real address and opening hours here.
const visit = [
  { icon: '📍', title: 'Address', titleKm: 'អាសយដ្ឋាន', text: 'Street 123, Phnom Penh', textKm: 'ផ្លូវលេខ ១២៣ ភ្នំពេញ' },
  { icon: '🕐', title: 'Open', titleKm: 'ម៉ោងបើក', text: 'Every day, 6 am – 8 pm', textKm: 'រៀងរាល់ថ្ងៃ ម៉ោង ៦ ព្រឹក – ៨ យប់' },
  { icon: '📱', title: 'Telegram', titleKm: 'តេឡេក្រាម', text: 'Message us to order', textKm: 'ផ្ញើសារមកយើងដើម្បីកុម្ម៉ង់' },
];

const faqs = [
  {
    q: 'Do you deliver?',
    qKm: 'តើអ្នកដឹកជញ្ជូនទេ?',
    a: 'Yes, in Phnom Penh. Send us a message on Telegram.',
    aKm: 'បាទ/ចាស នៅក្នុងភ្នំពេញ។ ផ្ញើសារមកយើងតាម Telegram។',
  },
  {
    q: 'Can I order a cake for a party?',
    qKm: 'តើខ្ញុំអាចកុម្ម៉ង់នំខេកសម្រាប់ពិធីជប់លៀងបានទេ?',
    a: 'Yes! Please order 2 days before, so we have time to make it.',
    aKm: 'បាន! សូមកុម្ម៉ង់មុន ២ ថ្ងៃ ដើម្បីឱ្យយើងមានពេលធ្វើវា។',
  },
  {
    q: 'How can I pay?',
    qKm: 'តើខ្ញុំអាចបង់ប្រាក់ដោយរបៀបណា?',
    a: 'Cash (dollars or riel) or KHQR.',
    aKm: 'សាច់ប្រាក់ (ដុល្លារ ឬរៀល) ឬ KHQR។',
  },
];
---

<Base>
  <Header />

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-sun/25 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-40 size-[30rem] rounded-full bg-brand/15 blur-3xl"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-white/70 px-3 py-1 text-sm font-medium">
            <span class="size-2 rounded-full bg-leaf"></span>
            A family bakery in Phnom Penh
          </p>
          <h1 class="mt-6 font-display text-5xl leading-[1.02] font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl">
            Fresh bread, baked with <span class="text-brand">love</span>.
          </h1>
          <p lang="km" class="mt-4 text-xl text-ink/70">នំប៉័ងស្រស់ ដុតដោយក្តីស្រលាញ់។</p>
          <p class="mt-6 max-w-xl text-lg text-muted">
            We bake bread, cakes, and pastries every morning. Come and taste!
            <span class="km" lang="km">យើងដុតនំប៉័ង នំខេក និងនំផ្សេងៗរៀងរាល់ព្រឹក។ សូមអញ្ជើញមកភ្លក់!</span>
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#menu" class="rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark">
              See our menu ↓ <span lang="km" class="font-khmer font-normal opacity-80">មើលម៉ឺនុយ</span>
            </a>
            <a href={site.telegram} class="rounded-full border border-ink/15 bg-white px-6 py-3 font-semibold transition hover:border-ink/40">
              Order on Telegram → <span lang="km" class="font-khmer font-normal opacity-60">កុម្ម៉ង់</span>
            </a>
          </div>
        </div>

        <!-- Illustration: a tray of today's bread -->
        <div class="relative" aria-hidden="true">
          <div class="rounded-3xl bg-gradient-to-br from-sun to-brand p-8 shadow-2xl">
            <div class="grid grid-cols-3 gap-4 text-center text-6xl sm:text-7xl">
              <span class="rounded-2xl bg-white/25 py-4">🥐</span>
              <span class="rounded-2xl bg-white/25 py-4">🥖</span>
              <span class="rounded-2xl bg-white/25 py-4">🍩</span>
              <span class="rounded-2xl bg-white/25 py-4">🎂</span>
              <span class="rounded-2xl bg-white/25 py-4">🍞</span>
              <span class="rounded-2xl bg-white/25 py-4">☕</span>
            </div>
          </div>
          <p class="absolute -bottom-5 left-6 rotate-[-4deg] rounded-full bg-ink px-5 py-2 font-display font-bold text-paper shadow-xl">
            Fresh today! <span lang="km" class="font-khmer font-normal">ស្រស់ថ្ងៃនេះ!</span>
          </p>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="border-y border-ink/10 bg-white">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-10 sm:px-6 md:grid-cols-3">
        {
          stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd class="font-display text-4xl font-extrabold text-brand">{s.value}</dd>
              <dd class="mt-1 text-sm text-muted">
                {s.label}
                <span class="km" lang="km">{s.labelKm}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- MENU -->
    <section id="menu" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">Our menu <span lang="km" class="font-khmer font-normal">· ម៉ឺនុយរបស់យើង</span></p>
      <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Something for everyone.</h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">មានអ្វីៗសម្រាប់គ្រប់គ្នា។</p>
      <ul class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          menu.map((m) => (
            <li class="rounded-2xl border border-ink/10 bg-white p-6 transition hover:-translate-y-1 hover:border-brand hover:shadow-xl">
              <div class="flex items-start justify-between">
                <span class="text-4xl">{m.icon}</span>
                <span class="rounded-full bg-sun/30 px-3 py-1 font-display font-bold">{m.price}</span>
              </div>
              <h3 class="mt-4 font-display text-2xl font-bold">
                {m.title}
                <span class="km text-lg" lang="km">{m.titleKm}</span>
              </h3>
              <p class="mt-2 text-muted">
                {m.text}
                <span class="km" lang="km">{m.textKm}</span>
              </p>
            </li>
          ))
        }
      </ul>
      <a href="/menu/" class="mt-10 inline-block rounded-full bg-brand px-6 py-3 font-semibold text-paper hover:bg-brand-dark">
        See the full menu → <span lang="km" class="font-khmer">មើលបញ្ជីនំទាំងអស់</span>
      </a>
    </section>

    <!-- BIG STATEMENT -->
    <section class="bg-ink text-paper">
      <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-28">
        <p class="font-display text-3xl leading-tight font-bold text-balance sm:text-5xl">
          The smell of <span class="text-sun">fresh bread</span> is the best way to start the day.
        </p>
        <p lang="km" class="km mt-6 text-xl sm:text-2xl">
          ក្លិននំប៉័ងស្រស់ គឺជាវិធីល្អបំផុតដើម្បីចាប់ផ្តើមថ្ងៃថ្មី។
        </p>
      </div>
    </section>

    <!-- WHY US + ABOUT -->
    <section id="about" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">About us <span lang="km" class="font-khmer font-normal">· អំពីយើង</span></p>
      <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
        A small family bakery.
      </h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ហាងនំប៉័ងគ្រួសារតូចមួយ។</p>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        We bake the recipes our family loves, and share them with our neighbors.
        <span class="km" lang="km">យើងដុតនំតាមរូបមន្តដែលគ្រួសារយើងស្រលាញ់ ហើយចែករំលែកវាជាមួយអ្នកជិតខាង។</span>
      </p>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          reasons.map((r) => (
            <li class="rounded-2xl border border-ink/10 bg-white p-6">
              <span class="text-3xl">{r.icon}</span>
              <h3 class="mt-4 font-display text-xl font-bold">
                {r.title}
                <span class="km text-base" lang="km">{r.titleKm}</span>
              </h3>
              <p class="mt-2 text-muted">
                {r.text}
                <span class="km" lang="km">{r.textKm}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- VISIT US -->
    <section id="visit" class="scroll-mt-20 bg-white">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1fr_1.4fr]">
        <div>
          <p class="font-semibold text-brand">Visit us <span lang="km" class="font-khmer font-normal">· មកលេងយើង</span></p>
          <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Come and say hello.</h2>
          <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">សូមអញ្ជើញមកលេង។</p>
        </div>
        <ul class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
          {
            visit.map((v) => (
              <li class="flex gap-4 rounded-2xl bg-paper p-6">
                <span class="text-3xl">{v.icon}</span>
                <div>
                  <h3 class="font-display text-lg font-bold">
                    {v.title} <span lang="km" class="font-khmer font-normal text-muted">· {v.titleKm}</span>
                  </h3>
                  <p class="mt-1 text-muted">
                    {v.text}
                    <span class="km" lang="km">{v.textKm}</span>
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-28">
      <h2 class="text-center font-display text-4xl font-extrabold tracking-tight">Questions</h2>
      <p class="km mt-2 text-center text-xl font-semibold" lang="km">សំណួរ</p>
      <div class="mt-10 divide-y divide-ink/10 border-y border-ink/10">
        {
          faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-bold">
                <span>
                  {f.q}
                  <span class="km text-base" lang="km">{f.qKm}</span>
                </span>
                <span class="text-2xl text-brand transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-muted">
                {f.a}
                <span class="km" lang="km">{f.aKm}</span>
              </p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- CALL TO ACTION -->
    <section id="contact" class="scroll-mt-20 px-4 pb-20 sm:px-6">
      <div class="mx-auto max-w-6xl rounded-3xl bg-brand px-6 py-16 text-center text-paper sm:py-20">
        <h2 class="font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">Hungry? Order now.</h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ឃ្លានទេ? កុម្ម៉ង់ឥឡូវនេះ។</p>
        <a href={site.telegram} class="mt-8 inline-block rounded-full bg-paper px-8 py-4 font-semibold text-ink transition hover:bg-sun">
          Message us on Telegram → <span lang="km" class="font-khmer font-normal">ផ្ញើសារតាម Telegram</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
